# Variáveis de ambiente do panlabs. Copie para `.env`, que é gitignored, e
# preencha. Nenhum valor real mora neste arquivo: ele é o contrato de quais
# variáveis existem, não o lugar onde elas valem.
#
# As duas primeiras são da aplicação. As demais são de trabalho de infra, e a
# aplicação não lê nenhuma delas (ver docs/agents/mcps.md).

# --- aplicação ---------------------------------------------------------------

# Postgres da vitrine. A aplicação degrada graciosamente sem ela: o redirect
# /go/[slug] continua respondendo, e só a gravação do clique vira no-op
# (ADR-0012).
DATABASE_URL=

# Token de leitura do GitHub, para a vitalidade live (commits e PRs) dos
# repositórios do catálogo. Sem ela, a vitalidade cai para os valores curados
# (ADR-0013). Escopo de leitura pública basta.
GITHUB_TOKEN=

# --- infra local -------------------------------------------------------------

# As duas que os MCPs de `.mcp.json` expandem por placeholder.

# Token de API da Hostinger, para o MCP do VPS.
HOSTINGER_API_TOKEN=

# Coolify: a URL tem default no `.mcp.json` e só precisa ser declarada aqui
# para apontar para outra instância. O token não tem default.
COOLIFY_BASE_URL=
COOLIFY_ACCESS_TOKEN=

# Esta não passa pelo `.mcp.json`: o MCP da Cloudflare é HTTP e autentica no
# navegador. Ela existe para o `curl` e o Terraform de DNS feitos à mão, e o
# escopo dela é de zona, então ela não cria zona nova.
CLOUDFLARE_DNS_TOKEN=
